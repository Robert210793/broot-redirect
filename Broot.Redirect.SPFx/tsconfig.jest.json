{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noImplicitAny": true,
    "types": ["jest", "node"],
    "lib": ["es2020", "dom"]
  },
  "include": ["src/**/*.ts", "tests/unit/**/*.ts"]
}
